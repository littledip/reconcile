# Anthropic API key — required to actually run the Classification Agent against a live model.
ANTHROPIC_API_KEY=

# Optional — if unset, falls back to mongomock (in-memory) for local dev without Docker.
MONGO_URI=

# Optional — if unset, falls back to fakeredis (in-memory) for local dev without Docker.
REDIS_URL=

# Model used by the agents. Defaults to Claude Sonnet for prototyping.
ANTHROPIC_MODEL=claude-sonnet-5
