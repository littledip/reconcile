# Anthropic API key — required to actually run the Classification Agent against a live model.
ANTHROPIC_API_KEY=

# Optional — if unset, falls back to mongomock (in-memory) for local dev without Docker.
MONGO_URI=

# Optional — if unset, falls back to fakeredis (in-memory) for local dev without Docker.
REDIS_URL=

# Optional — if unset, falls back to an in-memory reason-code lookup (same seed
# data used to populate real Neo4j) for local dev without Docker.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=reconcile-dev

# Model used by the agents. Defaults to Claude Sonnet for prototyping.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional -- if unset, episodic memory (Week 9-10) persists to ./chroma_data
# in the project root. Chroma is local either way (no Docker/account needed,
# unlike Mongo/Redis/Neo4j above) -- this just lets you point it elsewhere.
CHROMA_PERSIST_DIR=

# Optional -- a local model served via Ollama (e.g. an Unsloth-tuned Qwen
# model you've imported into Ollama). classification_agent.py prefers this
# automatically over Anthropic whenever it's reachable -- unset OLLAMA_MODEL
# (or stop Ollama) to fall back to ANTHROPIC_API_KEY above.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Optional -- force a specific classification provider instead of
# auto-detecting ("local" / "anthropic" / "heuristic"). Leave unset in normal
# dev; the test suite sets this itself (see tests/conftest.py).
LLM_PROVIDER=
